# MESA Recruit · 生产环境变量样例
# 复制为 .env(根目录)后填入真实值。.env 严禁入 Git(已在 .gitignore)。
# 凭证占位用 __SET_BY_OPS__,运维同事据此填生产值。

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=mesa
POSTGRES_USER=mesa
# 至少 24 字节随机串: openssl rand -base64 24
POSTGRES_PASSWORD=__SET_BY_OPS__

# ─── JWT ───────────────────────────────────────────────────────
# 至少 32 字节随机串: openssl rand -hex 32
JWT_SECRET=__SET_BY_OPS__

# ─── 站点 ──────────────────────────────────────────────────────
# CORS 白名单(后端用),逗号分隔多个 origin。生产请写真实域名,不要图省事写 *。
WEB_ORIGIN=https://recruit.example.com

# ─── 暴露端口 ──────────────────────────────────────────────────
# 默认 80;若已有 Cloudflare Tunnel 或外层 Nginx,可改成 8080 等内网端口
WEB_HTTP_PORT=80

# ─── 日志 ──────────────────────────────────────────────────────
LOG_LEVEL=info
SLOW_QUERY_MS=300
SLOW_REQUEST_MS=800

# ─── AI 任务队列 / 数据库连接 ───────────────────────────────────
AI_WORKER_CONCURRENCY=3
AI_QUEUE_MAX_WAITING=300
# 每个 Node 进程有主 Prisma 与设置 Prisma 两个连接池；默认每池 5。
PRISMA_CONNECTION_LIMIT=5

# ─── (阶段② R2)─────────────────────────────────────────────────
# 仅当后端接入 Cloudflare R2 后启用,占位先放着
R2_ACCOUNT_ID=__SET_BY_OPS__
R2_ACCESS_KEY_ID=__SET_BY_OPS__
R2_SECRET_ACCESS_KEY=__SET_BY_OPS__
R2_BUCKET=mesa-resumes
R2_PUBLIC_BASE_URL=https://r2.example.com

# ─── (阶段⑤ 备份)──────────────────────────────────────────────
# 备份桶独立于业务桶,只允许 backup 凭证写入
R2_BACKUP_BUCKET=mesa-backups

# ─── LLM 简历解析 (Kimi / Moonshot AI) ─────────────────────────
# 系统统一持有的 API Key,所有用户共享。https://platform.moonshot.cn
KIMI_API_KEY=__SET_BY_OPS__
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ─── 文档层 TextIn xParse(合合信息,可选)─────────────────────
# 控制台「工作台 > 账号设置 > 开发者信息」;未配置或 TEXTIN_ENABLED=false 时走 pdftotext → Kimi Files 回退链
TEXTIN_APP_ID=__SET_BY_OPS__
TEXTIN_SECRET_CODE=__SET_BY_OPS__
TEXTIN_ENABLED=false

# ─── 评估层 Jev / TypeSafe AI(可选)─────────────────────────
# https://api.typesafe.ai 控制台申请;JEV_MODE=shadow 时 Jev 只落评估表不改 UI,primary 才切主
JEV_API_KEY=__SET_BY_OPS__
JEV_ENABLED=false
JEV_MODE=shadow
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# ─── 飞书校招自动定薪 (复用lark-ingest及现有应用) ────────────
# 飞书自建应用凭证;缺省时 lark-ingest 容器会重启循环,不影响其它服务。
LARK_APP_ID=__SET_BY_OPS__
LARK_APP_SECRET=__SET_BY_OPS__
LARK_BRAND=feishu
# 内部政策JSON的Base64，由运维经安全通道写入服务器；禁止提交真实内容。
SALARY_POLICY_B64=__SET_BY_OPS__
# 不再使用旧LARK_UPLOAD_TOKEN；群绑定、合同地、HR操作人映射在校招定薪页配置。
# CLI事件不含租户字段时，用与群配置一致的租户标识。
LARK_TENANT_KEY=default
# 定薪目标地址，默认走内网backend；本地验证填写本地后端地址。
# LARK_MESA_BASE_URL=http://backend:3001
# 接收回执开关；最终定薪卡片由worker持久化发送，需机器人消息权限。
# LARK_REPLY_ENABLED=true

# ─── 飞书卡片回调(补充、纠正、重新定薪)────────────────────
# 飞书应用「事件订阅 / 回调」里的 Verification Token(校验回调来源,必填才安全)
FEISHU_VERIFICATION_TOKEN=__SET_BY_OPS__
# Encrypt Key:仅当你在飞书后台开启了加密才填;不填则回调走明文(更简单)
FEISHU_ENCRYPT_KEY=
