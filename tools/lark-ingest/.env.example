# 复制为.env，填现有机器人的凭证；不要提交真实值。
# 本地联调使用本地后端，不默认访问生产。
MESA_BASE_URL=http://127.0.0.1:3001
LARK_APP_ID=__SET_BY_OPS__
LARK_APP_SECRET=__SET_BY_OPS__
LARK_BRAND=feishu
# 与定薪页群配置一致；事件有tenant_key时优先使用事件值。
LARK_TENANT_KEY=default
# LARK_CLI=/opt/homebrew/bin/lark-cli
# REPLY_ENABLED=true
# 旧UPLOAD_TOKEN已停用，不能再通过机器人创建招聘候选人或JD评分。
